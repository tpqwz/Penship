<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.penship"
    android:versionCode="5"
    android:versionName="0.1.3-alpha">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Penship">
        <activity
            android:name="penship.Pen"
            android:label="Penship"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="penship" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Text the provider already labeled, including markdown. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/markdown" />
                <data android:mimeType="application/x-markdown" />
            </intent-filter>
            <!-- A markdown or text name, whatever mime the provider used. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".md" />
                <data android:pathSuffix=".MD" />
                <data android:pathSuffix=".markdown" />
                <data android:pathSuffix=".mdown" />
                <data android:pathSuffix=".mkd" />
                <data android:pathSuffix=".mkdn" />
                <data android:pathSuffix=".mdwn" />
                <data android:pathSuffix=".mdtxt" />
                <data android:pathSuffix=".mdtext" />
                <data android:pathSuffix=".mdx" />
                <data android:pathSuffix=".qmd" />
                <data android:pathSuffix=".rmd" />
                <data android:pathSuffix=".Rmd" />
                <data android:pathSuffix=".myst" />
                <data android:pathSuffix=".txt" />
                <data android:pathSuffix=".TXT" />
                <data android:pathSuffix=".text" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\..*\\.markdown" />
                <data android:pathPattern=".*\\..*\\..*\\.markdown" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.markdown" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.txt" />
            </intent-filter>
            <!-- Share sheet: a text or markdown file, or shared text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/markdown" />
                <data android:mimeType="application/x-markdown" />
            </intent-filter>
            <!-- The same names when the sender sets no mime type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathSuffix=".md" />
                <data android:pathSuffix=".MD" />
                <data android:pathSuffix=".markdown" />
                <data android:pathSuffix=".mdown" />
                <data android:pathSuffix=".mkd" />
                <data android:pathSuffix=".mkdn" />
                <data android:pathSuffix=".mdwn" />
                <data android:pathSuffix=".mdtxt" />
                <data android:pathSuffix=".mdtext" />
                <data android:pathSuffix=".mdx" />
                <data android:pathSuffix=".qmd" />
                <data android:pathSuffix=".rmd" />
                <data android:pathSuffix=".Rmd" />
                <data android:pathSuffix=".myst" />
                <data android:pathSuffix=".txt" />
                <data android:pathSuffix=".TXT" />
                <data android:pathSuffix=".text" />
            </intent-filter>
        </activity>
    </application>
</manifest>
